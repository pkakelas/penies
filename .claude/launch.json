{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "penia-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "penia-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002,
      "autoPort": false
    }
  ]
}

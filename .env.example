# Copy to .env and fill in. Used by worker.py and guitar_split.py; never commit .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret (server-side) API key: Supabase dashboard -> Project settings -> API keys.
SUPABASE_SECRET_KEY=
# Your key from https://mvsep.com/full_api
MVSEP_API_TOKEN=
# Only needed for `supabase db push`.
SUPABASE_DB_PASSWORD=
# Cloudflare R2, where the stems are kept (all four, or none to keep them in
# Supabase Storage). The endpoint is on the bucket's page ("S3 API"); the keys
# are an R2 API token with "Object Read & Write" on that bucket.
R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

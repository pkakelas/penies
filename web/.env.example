NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (browser-safe) API key: Supabase dashboard -> Project settings -> API keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The page where visitors pay for a pack of song requests (a Stripe Payment Link).
# Set the link to send people back to https://YOUR-SITE/?paid after the payment.
NEXT_PUBLIC_PAYMENT_LINK=
